# Copy to .env.local to test PostHog from your machine (.env.local is git-ignored).
# Leave both unset and analytics is completely off.

# PostHog → Project settings → Project API key (starts with phc_)
VITE_POSTHOG_KEY=

# US cloud is the default. EU cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
